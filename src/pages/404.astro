---
// Shown for any address under the blog that has no page. It echoes the
// address that was asked for and, the way git answers a mistyped command,
// points to the post whose address is the most similar: the two addresses
// as a diff, then the post itself. Enter opens it.
import Base from "../layouts/BlogBase.astro";
import PostCard from "../components/PostCard.astro";
import { pageUrl } from "../lib/blog-path";
import { getPosts } from "../lib/posts";

const posts = await getPosts();
const latest = posts.slice(0, 3);
const candidates = posts.map((post) => ({ slug: post.slug, title: post.title, url: pageUrl(`/${post.slug}`) }));
---

<Base title="Page not found" description="There is no page at this address on the OpenTeams Engineering Blog.">
	<meta slot="head" name="robots" content="noindex" />

	<section class="container-wide grid items-center gap-10 pt-14 pb-16 md:grid-cols-[1fr_1.15fr] md:gap-16 md:pt-20">
		<div>
			<h1 class="max-w-[460px] text-3xl leading-[1.1] font-bold tracking-tight md:text-[38px]">
				No post lives at this address
			</h1>
			<p class="mt-4 max-w-[440px] text-base leading-relaxed text-muted">
				The link may have a typo, or the post may have moved. Search for it, or start from the list of posts.
			</p>
			<div class="mt-8 flex flex-wrap gap-3">
				<button type="button" class="nf-action nf-action-primary" data-nf-search>Search posts</button>
				<a href={pageUrl()} class="nf-action">See all posts</a>
			</div>
		</div>

		<div class="nf-term" data-nf-term>
			<div class="mb-5 flex gap-2" aria-hidden="true">
				<i class="nf-dot"></i><i class="nf-dot"></i><i class="nf-dot"></i>
			</div>
			<p class="nf-line"><span class="nf-prompt" aria-hidden="true">$ </span>open <span data-nf-path>this address</span></p>
			<p class="nf-line nf-error">404: no post at this address</p>
			<div class="mt-6" data-nf-match hidden>
				<p class="nf-line nf-quiet">Did you mean</p>
				<p class="nf-line nf-diff nf-diff-asked"><span aria-hidden="true">- </span><span data-nf-asked></span></p>
				<p class="nf-line nf-diff nf-diff-found"><span aria-hidden="true">+ </span><span data-nf-found></span></p>
				<a class="nf-match" data-nf-link href={pageUrl()}></a>
				<p class="nf-line nf-quiet nf-hint">Press Enter to open it</p>
			</div>
			<p class="nf-line nf-quiet mt-6" data-nf-none>No similar post found. Search, or pick one below.</p>
		</div>
	</section>

	<div class="container-wide">
		<div class="border-t border-border pt-11 pb-8">
			<h2 class="text-[28px] font-bold tracking-tight">Latest posts</h2>
		</div>
		<div class="grid gap-x-10 gap-y-11 pb-20 md:grid-cols-3">
			{latest.map((post) => <PostCard post={post} />)}
		</div>
	</div>
</Base>

<script is:inline define:vars={{ candidates }}>
	// Pairs of neighbouring characters: "post" gives "po", "os", "st".
	const pairs = (text) => {
		const clean = text.toLowerCase().replace(/[^a-z0-9]+/g, "-");
		return new Set(Array.from({ length: Math.max(clean.length - 1, 0) }, (_, i) => clean.slice(i, i + 2)));
	};
	// 0 to 1: how alike two addresses are. Counts shared pairs, and treats a
	// short address that sits wholly inside a longer one as a near match.
	const likeness = (asked, slug) => {
		const a = pairs(asked);
		const b = pairs(slug);
		if (a.size < 3) return 0;
		const shared = [...a].filter((pair) => b.has(pair)).length;
		return Math.max((2 * shared) / (a.size + b.size), 0.9 * (shared / a.size));
	};

	const asked = location.pathname.split("/").filter(Boolean).pop() ?? "";
	document.querySelector("[data-nf-path]").textContent = location.pathname;

	const best = candidates
		.map((post) => ({ post, score: likeness(asked, post.slug) }))
		.sort((x, y) => y.score - x.score)[0];
	if (best && best.score >= 0.5) {
		const link = document.querySelector("[data-nf-link]");
		link.textContent = best.post.title;
		link.href = best.post.url;
		document.querySelector("[data-nf-asked]").textContent = asked;
		document.querySelector("[data-nf-found]").textContent = best.post.slug;
		document.querySelector("[data-nf-match]").hidden = false;
		document.querySelector("[data-nf-none]").hidden = true;
		// Enter opens the suggestion, unless the reader is in the search box or on another control.
		document.addEventListener("keydown", (event) => {
			const busy = event.target.closest("a, button, input, textarea, select, [contenteditable]");
			const enter = event.code === "Enter" || event.code === "NumpadEnter";
			if (enter && !busy && !event.metaKey && !event.ctrlKey && !event.altKey) location.assign(best.post.url);
		});
	}

	// Open the site search with the words of the address already typed in.
	document.querySelector("[data-nf-search]").addEventListener("click", () => {
		document.querySelector("[data-search-trigger]")?.click();
		const input = document.querySelector("[data-search-input]");
		if (!input) return;
		input.value = asked.replace(/[^a-zA-Z0-9]+/g, " ").trim();
		input.dispatchEvent(new Event("input", { bubbles: true }));
	});
</script>

<style>
	.nf-term {
		border-radius: 1rem;
		/* On the dark theme the page is navy too, so the card lifts a shade and gets an edge. */
		border: 1px solid light-dark(transparent, var(--color-border));
		background: light-dark(var(--color-deep), var(--color-surface));
		padding: 1.75rem 2rem 2.25rem;
		font-family: var(--font-mono);
		font-size: 15px;
		line-height: 1.9;
		color: #dce3ff;
	}
	.nf-dot {
		display: block;
		width: 0.6rem;
		height: 0.6rem;
		border-radius: 999px;
		background: #2c3d6e;
	}
	.nf-line {
		/* A long address wraps inside the card instead of widening the page. */
		overflow-wrap: anywhere;
	}
	.nf-prompt {
		color: #8aa2ff;
	}
	.nf-error {
		color: #ff8f73;
	}
	.nf-quiet {
		color: #9aa8d4;
	}
	.nf-diff {
		margin-top: 0.3rem;
		border-radius: 0.4rem;
		padding: 0.05rem 0.7rem;
	}
	.nf-diff-asked {
		background: rgb(255 143 115 / 0.12);
		color: #ff8f73;
	}
	.nf-diff-found {
		background: rgb(127 212 163 / 0.12);
		color: #7fd4a3;
	}
	.nf-hint {
		margin-top: 0.6rem;
		font-size: 13px;
	}
	/* A touch screen has no Enter to press. */
	@media (hover: none) {
		.nf-hint {
			display: none;
		}
	}
	.nf-match {
		display: inline-block;
		margin-top: 1.1rem;
		font-family: var(--font-sans);
		font-size: 21px;
		font-weight: 600;
		line-height: 1.3;
		color: #ffffff;
		text-decoration: underline;
		text-decoration-color: #7fd4a3;
		text-decoration-thickness: 2px;
		text-underline-offset: 5px;
	}
	.nf-match:hover {
		color: #7fd4a3;
	}
	.nf-action {
		display: inline-flex;
		align-items: center;
		border-radius: 999px;
		border: 1px solid var(--color-border);
		padding: 0.7rem 1.4rem;
		font-size: 15px;
		font-weight: 600;
		color: var(--color-text);
		cursor: pointer;
		transition: border-color 0.15s ease, color 0.15s ease, background-color 0.15s ease;
	}
	.nf-action:hover {
		border-color: var(--color-brand);
		color: var(--color-brand);
	}
	.nf-action-primary {
		border-color: light-dark(var(--color-deep), var(--color-brand));
		background: light-dark(var(--color-deep), var(--color-brand));
		color: #ffffff;
	}
	.nf-action-primary:hover {
		border-color: var(--color-brand);
		background: var(--color-brand);
		color: #ffffff;
	}
	.nf-action:focus-visible,
	.nf-match:focus-visible {
		outline: 2px solid var(--color-brand);
		outline-offset: 3px;
	}
</style>
