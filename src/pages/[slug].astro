---
import { render } from "astro:content";
import Base from "../layouts/BlogBase.astro";
import Avatar from "../components/Avatar.astro";
import SubscribeBand from "../components/SubscribeBand.astro";
import CodeCopy from "../components/CodeCopy.astro";
import ShareLinks from "../components/ShareLinks.astro";
import PostTitle from "../components/PostTitle.astro";
import { getPosts, type Post } from "../lib/posts";
import ogImages from "../data/og-images.json";
import { blogUrl } from "../lib/blog-path";

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post.entry);
const { title, excerpt, minutes, authors, topic } = post;
const publishedDate = post.date;
const hasDiagram = /^```mermaid\s*$/m.test(post.entry.body ?? "");
const ogPath = (ogImages as Record<string, string>)[post.slug];
const ogImage = ogPath ? blogUrl(ogPath) : undefined;
---

<Base title={title} description={excerpt} image={ogImage} type="article">
	{hasDiagram && (
		<link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Shantell+Sans:wght@400;500;600&display=swap" />
	)}
	<div class="mx-auto max-w-[1120px] xl:grid xl:grid-cols-[minmax(0,1fr)_220px] xl:gap-16">
		<div class="min-w-0">
			<article class="mx-auto max-w-[680px] px-6 pt-16">
				<header class="mb-8">
					<div class="flex items-center gap-3">
						<a href={blogUrl("/")} class="cat-label hover:underline">Engineering Blog</a>
						{topic && (
							<a
								href={blogUrl(`/tag/${topic.slug}`)}
								class="rounded-full border border-border px-2.5 py-1 text-[11px] font-semibold tracking-wide text-muted uppercase hover:border-brand hover:text-brand"
							>
								{topic.label}
							</a>
						)}
					</div>
					<h1 class="font-display mt-4 text-3xl leading-[1.2] font-bold tracking-tight md:text-[34px]">
						<PostTitle parts={post.titleParts} />
					</h1>
					{excerpt && <p class="mt-4 text-lg leading-relaxed text-muted">{excerpt}</p>}
					<div class="mt-7 flex flex-wrap items-center gap-x-8 gap-y-4 border-y border-border py-4">
						{authors.map((a) => (
							<a href={blogUrl(`/author/${a.slug}`)} class="group flex items-center gap-2.5">
								<Avatar name={a.name} src={a.avatarUrl} size={38} />
								<div>
									<div class="text-base leading-tight font-semibold group-hover:text-brand">{a.name}</div>
									<div class="mt-0.5 text-sm leading-tight text-faint">
										{a.bio.split(".")[0] || "OpenTeams"}
									</div>
								</div>
							</a>
						))}
						<div class="ml-auto text-right text-xs leading-relaxed text-faint">
							<time datetime={publishedDate.toISOString()} class="block">
								{publishedDate.toLocaleDateString("en-US", {
									year: "numeric",
									month: "long",
									day: "numeric",
								})}
							</time>
							<span>{minutes} min read</span>
						</div>
					</div>
				</header>
			</article>
			<div class="editorial-content max-w-[680px] pb-16">
				<Content />
			</div>

			{authors.length > 0 && (
				<aside class="mx-auto flex max-w-[680px] flex-col items-center gap-10 px-6 pt-4 text-center" aria-label="About the authors">
					{authors.map((a) => (
						<div class="flex flex-col items-center">
							<a href={blogUrl(`/author/${a.slug}`)} aria-label={`Posts by ${a.name}`}>
								<Avatar name={a.name} src={a.avatarUrl} size={72} />
							</a>
							<a href={blogUrl(`/author/${a.slug}`)} class="author-name mt-4 hover:text-brand">{a.name}</a>
							{a.bio && <p class="mt-2 max-w-[560px] leading-relaxed text-muted">{a.bio}</p>}
						</div>
					))}
				</aside>
			)}

			<ShareLinks title={title} url={new URL(Astro.url.pathname, Astro.site).href} />
		</div>

		<aside class="hidden xl:block" aria-label="Table of contents">
			<nav class="sticky top-24 pt-16" aria-label="On this page" id="toc" hidden>
				<div class="toc-title">On this page</div>
				<ul class="toc-list" id="toc-list"></ul>
			</nav>
		</aside>
	</div>

	<SubscribeBand />
	<CodeCopy />

	<script>
		// On-this-page rail + heading anchor links, from the rendered content.
		// Headings get stable slug ids, a hover "#" link, and the rail tracks
		// the section currently in view.
		const container = document.querySelector(".editorial-content");
		const toc = document.getElementById("toc");
		const tocList = document.getElementById("toc-list");
		const headings = container
			? [...container.querySelectorAll<HTMLHeadingElement>("h2")]
			: [];

		if (toc && tocList && headings.length >= 2) {
			const seen = new Map<string, number>();
			for (const h of headings) {
				if (!h.id) {
					let id = (h.textContent ?? "")
						.toLowerCase()
						.replace(/[^a-z0-9\s-]/g, "")
						.trim()
						.replace(/\s+/g, "-");
					const n = seen.get(id) ?? 0;
					seen.set(id, n + 1);
					if (n > 0) id = `${id}-${n}`;
					h.id = id;
				}
				const anchor = document.createElement("a");
				anchor.className = "heading-anchor";
				anchor.href = `#${h.id}`;
				anchor.textContent = "#";
				anchor.setAttribute("aria-label", "Link to this section");
				h.appendChild(anchor);

				const li = document.createElement("li");
				const link = document.createElement("a");
				link.href = `#${h.id}`;
				link.textContent = (h.textContent ?? "").replace(/#$/, "");
				li.appendChild(link);
				tocList.appendChild(li);
			}
			toc.hidden = false;

			const links = new Map(
				[...tocList.querySelectorAll<HTMLAnchorElement>("a")].map((a) => [
					a.hash.slice(1),
					a,
				]),
			);
			let activeId: string | null = null;
			const setActive = (id: string) => {
				if (id === activeId) return;
				activeId = id;
				links.forEach((a, key) => a.classList.toggle("active", key === id));
			};
			const observer = new IntersectionObserver(
				(entries) => {
					for (const e of entries) {
						if (e.isIntersecting) setActive(e.target.id);
					}
				},
				{ rootMargin: "-96px 0px -70% 0px", threshold: 0 },
			);
			headings.forEach((h) => observer.observe(h));
			setActive(headings[0].id);
		}
	</script>

	<script>
		// Hand-drawn Mermaid diagrams, coloured from the --doodle-* variables in
		// global.css; mermaid itself loads from a pinned CDN only when the page
		// has a diagram, and diagrams re-render on the light/dark toggle.
		import { createRenderer } from "mermaid-doodle";
		import "mermaid-doodle/styles.css";

		// Label boxes are measured at render time, so the handwriting font
		// must be loaded first or labels get clipped.
		if (document.querySelector("code.language-mermaid")) {
			await Promise.all([
				document.fonts.load('400 16px "Shantell Sans"'),
				document.fonts.load('600 16px "Shantell Sans"'),
			]).catch(() => {});
		}
		await createRenderer().mount();

		// Diagrams shrink to the column width, so a click (or Enter) opens one
		// full screen in a dialog. The clone keeps the SVG's id, which its
		// mermaid styles are scoped to, and sits in a .doodle-diagram so the
		// label font rules still apply (data-processed, or mermaid-doodle's
		// stylesheet hides it as not yet rendered). The theme toggle re-renders diagrams
		// in place, so the clone is taken fresh on every open.
		const wraps = document.querySelectorAll(".doodle-wrap");
		if (wraps.length) {
			const zoom = document.createElement("dialog");
			zoom.className = "diagram-zoom";
			zoom.setAttribute("aria-label", "Diagram, full screen");
			zoom.innerHTML =
				'<button type="button" class="diagram-zoom-close" aria-label="Close diagram">&times;</button><div class="doodle-diagram" data-processed></div>';
			document.body.append(zoom);
			const zoomBody = zoom.querySelector(".doodle-diagram")!;
			zoom.addEventListener("click", () => zoom.close());
			// Focus goes back to the diagram that was opened.
			let opener: HTMLElement | null = null;
			zoom.addEventListener("close", () => {
				zoomBody.replaceChildren();
				opener?.focus();
				opener = null;
			});

			function openDiagram(wrap: Element) {
				const svg = wrap.querySelector("svg");
				if (!svg) return;
				const copy = svg.cloneNode(true) as SVGSVGElement;
				copy.removeAttribute("style");
				copy.removeAttribute("width");
				copy.removeAttribute("height");
				zoomBody.replaceChildren(copy);
				opener = wrap as HTMLElement;
				zoom.showModal();
			}

			for (const wrap of wraps) {
				wrap.setAttribute("role", "button");
				wrap.setAttribute("tabindex", "0");
				wrap.setAttribute("aria-label", "Open diagram full screen");
				wrap.addEventListener("click", () => openDiagram(wrap));
				wrap.addEventListener("keydown", (e) => {
					const key = (e as KeyboardEvent).key;
					if (key === "Enter" || key === " ") {
						e.preventDefault();
						openDiagram(wrap);
					}
				});
			}
		}
	</script>
</Base>
