---
import Base from "../../layouts/BlogBase.astro";
import Avatar from "../../components/Avatar.astro";
import AuthorLinks from "../../components/AuthorLinks.astro";
import PostCard from "../../components/PostCard.astro";
import { pageUrl } from "../../lib/blog-path";
import { authorsOf, getPosts, type Author, type Post } from "../../lib/posts";

export async function getStaticPaths() {
	return authorsOf(await getPosts()).map(({ author, posts }) => ({
		params: { slug: author.slug },
		props: { author, posts },
	}));
}

const { author, posts } = Astro.props as { author: Author; posts: Post[] };
---

<Base title={`${author.name} | Engineering Blog`} description={author.bio || undefined} og={`author-${author.slug}`}>
	<section class="container-wide pt-16 pb-10">
		<a href={pageUrl()} class="cat-label">&larr; Engineering Blog</a>
		<!-- From a phone up, the photo is a square as tall as the text beside it: top of the name to the bottom of the links. -->
		<div class="mt-5 grid gap-5 sm:grid-cols-[auto_1fr]">
			<div class="relative size-[88px] sm:aspect-square sm:h-full sm:w-auto">
				<Avatar name={author.name} src={author.avatarUrl} size={88} fill class="absolute inset-0 h-full w-full" />
			</div>
			<div>
				<h1 class="text-4xl leading-none font-bold tracking-tight md:text-5xl">{author.name}</h1>
				{author.bio && <p class="mt-2 max-w-[640px] text-lg text-muted">{author.bio}</p>}
				<AuthorLinks author={author} class="mt-3 -ml-2" />
			</div>
		</div>
		<p class="mt-6 text-sm font-semibold tracking-[0.08em] text-faint uppercase">
			{posts.length} article{posts.length === 1 ? "" : "s"}
		</p>
	</section>
	<h2 class="sr-only">Posts by {author.name}</h2>
	<div class="container-wide grid gap-x-10 gap-y-11 pb-22 md:grid-cols-3">
		{posts.map((p) => <PostCard post={p} />)}
	</div>
</Base>
