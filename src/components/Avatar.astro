---
// Author avatar: real photo when the byline has one, otherwise an
// initials tile on the brand gradient so every byline still gets a face.
interface Props {
	name: string;
	src?: string | null;
	size?: number;
	/** Leave the box size to the caller's classes; `size` then only sets the initials' type size. */
	fill?: boolean;
	class?: string;
}

const { name, src, size = 36, fill = false, class: className } = Astro.props;
const box = fill ? "" : `width:${size}px;height:${size}px;`;
const initials = name
	.split(/\s+/)
	.map((w) => w[0])
	.filter(Boolean)
	.slice(0, 2)
	.join("")
	.toUpperCase();
---

{src ? (
	<img
		src={src}
		alt={name}
		width={size}
		height={size}
		loading="lazy"
		class:list={["shrink-0 rounded-full object-cover", className]}
		style={box || undefined}
	/>
) : (
	<span
		class:list={[
			"flex shrink-0 items-center justify-center rounded-full bg-linear-to-br from-brand-strong to-brand font-semibold text-white",
			className,
		]}
		style={`${box}font-size:${Math.round(size * 0.36)}px`}
		aria-hidden="true"
	>
		{initials}
	</span>
)}
