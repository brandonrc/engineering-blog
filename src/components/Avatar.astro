---
// Author avatar: real photo when the byline has one, otherwise an
// initials tile on the brand gradient so every byline still gets a face.
interface Props {
	name: string;
	src?: string | null;
	size?: number;
	class?: string;
}

const { name, src, size = 36, class: className } = Astro.props;
const initials = name
	.split(/\s+/)
	.map((w) => w[0])
	.filter(Boolean)
	.slice(0, 2)
	.join("")
	.toUpperCase();
---

{src ? (
	<img
		src={src}
		alt={name}
		width={size}
		height={size}
		loading="lazy"
		class:list={["shrink-0 rounded-full object-cover", className]}
		style={`width:${size}px;height:${size}px`}
	/>
) : (
	<span
		class:list={[
			"flex shrink-0 items-center justify-center rounded-full bg-linear-to-br from-brand-strong to-brand font-semibold text-white",
			className,
		]}
		style={`width:${size}px;height:${size}px;font-size:${Math.round(size * 0.36)}px`}
		aria-hidden="true"
	>
		{initials}
	</span>
)}
