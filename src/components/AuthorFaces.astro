---
// Every author's avatar, overlapped left to right, for a post byline.
// No known author falls back to one team tile, matching bylineNames().
import Avatar from "./Avatar.astro";
import { bylineNames } from "../lib/byline";
import type { Author } from "../lib/posts";

interface Props {
	authors: Author[];
	size: number;
}

const { authors, size } = Astro.props;
const faces = authors.length ? authors : [{ name: bylineNames([]), avatarUrl: null }];
---

<span class="post-byline-faces flex shrink-0">
	{faces.map((a, i) => (
		<span class="rounded-full ring-2 ring-[var(--color-bg)]" style={i ? `margin-left:${-Math.round(size * 0.3)}px` : undefined}>
			<Avatar name={a.name} src={a.avatarUrl} size={size} />
		</span>
	))}
</span>
