---
// An author's profiles elsewhere (GitHub, LinkedIn, X, Bluesky, own site) as
// a row of icons; renders nothing for an author without any. Logos follow
// ShareLinks: Simple Icons for X and Bluesky, Phosphor for the rest.
import { Icon } from "astro-iconset/components";
import xLogo from "../icons/share/x.svg?raw";
import bskyLogo from "../icons/share/bluesky.svg?raw";
import type { Author } from "../lib/posts";

interface Props {
	author: Author;
	class?: string;
}

const { author, class: className } = Astro.props;
const svg = (raw: string) => raw.replace("<svg ", '<svg width="18" height="18" fill="currentColor" aria-hidden="true" ');
const places = [
	{ key: "github", name: "GitHub", icon: "ph:github-logo" },
	{ key: "linkedin", name: "LinkedIn", icon: "ph:linkedin-logo" },
	{ key: "x", name: "X", logo: svg(xLogo) },
	{ key: "bluesky", name: "Bluesky", logo: svg(bskyLogo) },
	{ key: "website", name: "website", icon: "ph:globe" },
] as const;
const links = places.flatMap((place) => {
	const url = author.links?.[place.key];
	const label = place.name === "website" ? `${author.name}'s website` : `${author.name} on ${place.name}`;
	return url ? [{ ...place, url, label }] : [];
});
---

{links.length > 0 && (
	<ul class:list={["flex items-center gap-1", className]} aria-label={`${author.name} elsewhere`}>
		{links.map((link) => (
			<li>
				<a
					href={link.url}
					target="_blank"
					rel="noopener noreferrer me"
					aria-label={`${link.label} (opens in a new tab)`}
					title={link.label}
					class="flex size-9 items-center justify-center rounded-full text-faint transition-colors hover:text-text focus-visible:text-text"
				>
					{"logo" in link ? <Fragment set:html={link.logo} /> : <Icon name={link.icon} class="text-[22px]" aria-hidden="true" />}
				</a>
			</li>
		))}
	</ul>
)}
